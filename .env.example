# Absolute origin of the deployed site (no trailing slash).
# Drives canonical URLs, hreflang alternates, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://avtomaktabturon.uz

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ---------------------------------------------------------------------------
# Pooled connection used by the running app.
DATABASE_URL=
# Direct (unpooled) connection — migrations only.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Lead notifications (TZ flow F-02)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Admin panel seeding
# ---------------------------------------------------------------------------
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# AI assistant (chat widget)
# ---------------------------------------------------------------------------
# Server-side only — never prefix with NEXT_PUBLIC_. Without it the chat
# endpoint returns 503 and the widget shows its "unavailable" state; the rest
# of the site is unaffected.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Set claude-haiku-5-5 to trade
# capability for cost at high volume.
ANTHROPIC_MODEL=
